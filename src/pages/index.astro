---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeaderLink from '../components/HeaderLink.astro';
import GraphicDesignComp from '../components/GraphicDesignComp.astro';
import WebDesignComp from '../components/WebDesignComp.astro';
import PaintingComp from '../components/PaintingComp.astro';
import GirlwithCatSpeaking from '../components/GirlwithCatSpeaking.astro';
import EyeFollower from '../components/EyeFollower.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<GirlwithCatSpeaking class="girl-w-cat-position"/>
			<HeaderLink href="/graphic-design" class="graphic-design-position" aria-label="View Graphic Design portfolio">
				<GraphicDesignComp />
			</HeaderLink>
			<HeaderLink href="/animation" class="eye-follower-position" aria-label="View animation portfolio">
				<EyeFollower />
			</HeaderLink>
			<a href="https://bedesignlab.com" target="_blank" class="web-design-position" aria-label="Visit be design lab website (opens in new tab)"
				rel="noopener noreferrer">
				<WebDesignComp />
			</a>
			<HeaderLink href="/paintings" class="painting-position" aria-label="View Painting portfolio">
				<PaintingComp />
			</HeaderLink>
		</main>
		<Footer />
	</body>
	<style>
		:global(html), :global(body) {
			height: 100vh;
			margin: 0;
			overflow: hidden;
		}

		:global(body) {
			display: flex;
			flex-direction: column;
		}

		main {
			display: grid;
			grid-template-columns: repeat(12, 1fr);
			grid-template-rows: repeat(12, 1fr);
			flex: 1;
			gap: 1rem;
			padding-top: 2px;
			min-height: 0;
		}		
 
		/* Girl with Cat - centered, occupies middle third */
		:global(.girl-w-cat-position) {
			grid-column: 5 / 9;
			grid-row: 5 / 13;
			z-index: 1;
		}
 
		/* Graphic Design - bottom left */
		.graphic-design-position {
			grid-column: 2 / 4;
			grid-row: 8 / 11;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: transform 0.3s ease;
		}
 
		/* Web Design - top right */
		.web-design-position {
			grid-column: 10 / 13;
			grid-row: 1 / 3;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: transform 0.3s ease;
		}

		.painting-position {
			grid-column: 9 / 11;
			grid-row: 7 / 11;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: transform 0.3s ease;
		}

		.eye-follower-position {
			grid-column: 6 / 8;
			grid-row: 2 / 4;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: transform 0.3s ease;
		}

		/* KEYBOARD FOCUS STYLES - CRITICAL FOR ACCESSIBILITY */
		.graphic-design-position:focus,
		.web-design-position:focus,
		.painting-position:focus,
		.eye-follower-position:focus {
			outline: 3px solid var(--dark-purple, #250E3B);
			outline-offset: 4px;
			transform: scale(1.05);
		}

		/* Alternative focus style with ring */
		.graphic-design-position:focus-visible,
		.web-design-position:focus-visible,
		.painting-position:focus-visible,
		.eye-follower-position:focus-visible {
			outline: 3px solid var(--dark-purple, #250E3B);
			outline-offset: 4px;
			box-shadow: 0 0 0 6px rgba(37, 14, 59, 0.1);
		}

		/* Make content scale to fit */
		:global(.girl-w-cat-position),
		.graphic-design-position,
		.web-design-position,
		.painting-position,
		.eye-follower-position {
			width: 100%;
			height: 100%;
		}

		/* Ensure SVGs scale properly */
		:global(.girl-w-cat-position > svg),
		:global(.graphic-design-position > *),
		:global(.web-design-position > *),
		.painting-position > *,
		.eye-follower-position > * {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		.mobile-categories {
			display: none;
		}
 
		/* Tablet/Small Desktop Responsive */
		@media (max-width: 1024px) {
			main {
				gap: 0.5rem;
				padding: 0.5rem;
			}
 
			:global(.girl-w-cat-position) {
				grid-column: 4 / 10;
				grid-row: 3 / 9;
			}
 
			.graphic-design-position {
				grid-column: 1 / 5;
				grid-row: 10 / 13;
			}
 
			.web-design-position {
				grid-column: 9 / 13;
				grid-row: 1 / 4;
			}

			.painting-position {
				grid-column: 8 / 12;
				grid-row: 10 / 12;
			}
		}
 
		/* Mobile Responsive */
		@media (max-width: 768px) {
			main {
				display: flex;
				flex-direction: column;
				height: auto;
				gap: 2rem;
				padding: 1rem;
				justify-content: center;
			}
 
			:global(.girl-w-cat-position),
			:global(.girl-w-cat-position > svg) {
				width: 80%;
				height: auto;
				max-height: 50vh;
			}
 
			/* Stack order: Web Design, Girl, Graphic Design */ 
			:global(.girl-w-cat-position) {
				order: 1;
			}

			.web-design-position,
			.graphic-design-position,
			.painting-position,
			.eye-follower-position {
				display: none;
			}

			.mobile-categories {
				display: flex;
				flex-flow: column nowrap;
				order: 2;
			}
		}
	</style>
	<script>
		import { gsap } from "gsap";
		// Person reacts on hover
		const person = document.querySelector(".girl-w-cat-position");

		person?.addEventListener("mouseenter", () => {
			gsap.to(".dialogue-bubble", { opacity: 1, visibility: "visible" });
		});

		person?.addEventListener("mouseleave", () => {
			gsap.to(".dialogue-bubble", { opacity: 0, visibility: "hidden" });
		});
	</script>
</html>
