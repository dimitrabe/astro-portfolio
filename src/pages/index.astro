---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import GraphicDesignComp from '../components/GraphicDesignComp.astro';
import WebDesignComp from '../components/WebDesignComp.astro';
import GirlwithCatSpeaking from '../components/GirlwithCatSpeaking.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<p class="dialogue-bubble">
					Spiralling somewhere between design, art & engineering. <br/>How
					can I help?
			</p>		
			<GirlwithCatSpeaking class="girl-w-cat-position"/>
			<GraphicDesignComp class="graphic-design-position" />
			<WebDesignComp class="web-design-position" />
		</main>
		<Footer />
	</body>
	<style>
		main {
			display: grid;
			grid-template-columns: repeat(12, 1fr);
			grid-template-rows: repeat(12, 1fr);
			width: 100vw;
			height: 88vh;
			gap: 0;
			padding: 0;
		}		

		:global(.girl-w-cat-position) {
			grid-column: 6 / 9;
			grid-row: 3 / 12;
		}

		:global(.graphic-design-position) {
			grid-column: 2 / 5; /* spans columns 6-9 */
			grid-row: 11; /* spans rows 5-8 */
		}

		:global(.web-design-position) {
			grid-column: 10 / 13; /* spans columns 8-12 */
			grid-row: 1 / 3; /* spans rows 8-12 */
		}

		/* Make content scale to fit */
		:global(.girl-w-cat-position),
		:global(.graphic-design-position),
		:global(.web-design-position) {
			width: 100%;
			height: auto;
		}
		/* If wrapping components, apply to their children */
		:global(.girl-w-cat-position > *),
		:global(.graphic-design-position > *),
		:global(.web-design-position > *) {
			width: 100%;
			height: auto;
			margin: auto;
		}

		.dialogue-bubble {
			opacity: 0;
			visibility: hidden;
			border: 1px solid var(--accent);
			border-radius: 9999px;
			/* background: var(--accent); */
			grid-column: 5 / 7;
			grid-row: 2 / 3;
			margin: auto;
			padding: 1em 2em;
			height: fit-content;
			max-width: 30ch;
		}
	</style>
	<script>
		import { gsap } from "gsap";
		// Person reacts on hover
		const person = document.querySelector(".girl-w-cat-position");

		person?.addEventListener("mouseenter", () => {
			gsap.to(".dialogue-bubble", { opacity: 1, visibility: "visible" });
		});

		person?.addEventListener("mouseleave", () => {
			gsap.to(".dialogue-bubble", { opacity: 0, visibility: "hidden" });
		});
	</script>
</html>
