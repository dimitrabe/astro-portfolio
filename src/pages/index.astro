---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import GraphicDesignComp from '../components/GraphicDesignComp.astro';
import WebDesignComp from '../components/WebDesignComp.astro';
import GirlwithCatSpeaking from '../components/GirlwithCatSpeaking.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<GirlwithCatSpeaking>
			<GraphicDesignComp />
			<WebDesignComp />
		</main>
		<Footer />
	</body>
	<style>
		main {
			height: 72vh;
		}
	</style>
</html>
