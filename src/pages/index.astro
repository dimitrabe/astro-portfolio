---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import GraphicDesignComp from '../components/GraphicDesignComp.astro';
import WebDesignComp from '../components/WebDesignComp.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import GirlWithCatSVG from '../assets/girl_with_cat.svg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="girl-with-cat">
				<p class="dialogue-bubble">Spiralling somewhere between design, art & engineering. How can I help?</p>
				<GirlWithCatSVG />
			</div>
			<GraphicDesignComp />
			<WebDesignComp />
		</main>
		<Footer />
	</body>
	<style>
		main {
			height: 72vh;
		}
		.girl-with-cat {
			cursor: pointer;
			display: grid;
			grid-template-columns: 1fr 1fr 1fr;
			grid-template-rows: 1fr 1fr 1fr;
		}
		.girl-with-cat svg{
			grid-column: 2 / span 2;
			grid-row: 2 / span 2;
		}
		.dialogue-bubble {
			opacity: 0;
			visibility: hidden;
			grid-column: 1 / span 2;
			grid-row: 1 / 1;
			border: 1px solid var(--accent);
			border-radius: 9999px;
			background: var(--accent);
			margin: auto;
			padding: 2em;
		}
		.dialogue-bubble:after {
			content: '';
			position: relative;
			bottom: -30%;
			left: 0;
			width: 0;
			height: 0;
			border: 36px solid transparent;
			border-top-color: var(--accent);
			border-bottom: 0;
			border-right: 0;
			margin-left: -18px;
			margin-bottom: -36px;
		}

	</style>
	<script>
    	import { gsap } from 'gsap';

		const EYES_FRAME_DURATION = 0.4;
		const BLINK_DELAY=6;
		const EASE_FUNCTION = "slow(0.9,1,false)";

		let tl_eye_left = gsap.timeline({repeat:-1});
		let tl_eye_right = gsap.timeline({repeat:-1});
		tl_eye_left.to(".iris-left-diamond", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
  				.to(".iris-left-square", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1}, "<")
				.to(".iris-left-square", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
  				.to(".iris-left-triangle", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1}, "<")
				.to(".iris-left-triangle", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
				.to(".iris-left-star", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1}, "<")
				.to(".iris-left-star", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
				.to(".iris-left-diamond", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1},"<")

		tl_eye_right.to(".iris-right-diamond", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
  				.to(".iris-right-square", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1}, "<")
				.to(".iris-right-square", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
  				.to(".iris-right-triangle", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1}, "<")
				.to(".iris-right-triangle", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
				.to(".iris-right-star", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1}, "<")
				.to(".iris-right-star", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 0})
				.to(".iris-right-diamond", {duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1},"<")
		
		// Person reacts on hover
		const person = document.querySelector('.girl-with-cat');
		
		person?.addEventListener('mouseenter', () => {
			tl_eye_left.pause();
			tl_eye_right.pause();
			gsap.to(".iris", {opacity: 0});
			gsap.to(".iris-left-open", {opacity: 1});
			gsap.to(".iris-right-open", {opacity: 1});
			gsap.to(".dialogue-bubble", {opacity: 1, visibility:"visible"});
		});
		
		person?.addEventListener('mouseleave', () => {
			gsap.to(".iris-left-open", {opacity: 0});
			gsap.to(".iris-right-open", {opacity: 0});
			tl_eye_left.resume();
			tl_eye_right.resume();
			gsap.to(".dialogue-bubble", {opacity: 0, visibility:"hidden"});
		});
	</script>
</html>
