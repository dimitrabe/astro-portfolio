---
import { getCollection } from 'astro:content';

import WebDesignLayout from '../../layouts/WebDesignLayout.astro';
import PaintingLayout from '../../layouts/PaintingLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Get unique categories
  const categories = [...new Set(allPosts.map(post => post.data.category))];
  
  return categories.map(category => {
    const posts = allPosts
      .filter(post => post.data.category === category)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    
    return {
      params: { category },
      props: { posts, category }
    };
  });
}

const { posts, category } = Astro.props;

// Map categories to their respective layouts
const layoutMap: Record<string, any> = {
  'web-design': WebDesignLayout,
  'paintings': PaintingLayout,
  // Add more categories here as you create them
};

const Layout = layoutMap[category] || WebDesignLayout; // Fallback to default layout
---

<Layout title={`${category.charAt(0).toUpperCase() + category.slice(1).replace('-', ' ')} Posts`} category={category}>
  <div class="posts-grid">
    {posts.map((post) => (
      <article class="blog-post">
        <a href={`/${post.data.category}/${post.id}/`}>
          {post.data.heroImage && (
            <img class="post-image"
				src={post.data.heroImage.src} 
				alt={post.data.title} 
				width={post.data.heroImage.width} 
				height={post.data.heroImage.height} />
          )}
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-description">{post.data.description}</p>
          <time class="post-time" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
        </a>
      </article>
    ))}
  </div>
</Layout>
