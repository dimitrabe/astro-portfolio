---
import type { SvgComponent } from "astro/types";
import myLogo from "../assets/logo-be-design-lab-vector.svg";

const MyLogoComponent = myLogo as SvgComponent;
---

<a href="/">
  <MyLogoComponent />
</a>

<style>
  a {
    display: inline-block;
    max-width: 180px;
    width: 100%;
    padding-top: 0px;
  }

</style>