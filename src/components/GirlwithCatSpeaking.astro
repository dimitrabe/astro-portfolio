<style>
    .girl-with-cat {
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
    }
    .girl-with-cat > svg > g{
        width: 100%;
        height: auto;
        max-width: 100%;
        max-height: 100%;
    }
</style>
<script>
    import { gsap } from "gsap";

    const EYES_FRAME_DURATION = 0.4;
    const BLINK_DELAY = 6;
    const EASE_FUNCTION = "slow(0.9,1,false)";

    let tl_eye_left = gsap.timeline({ repeat: -1 });
    let tl_eye_right = gsap.timeline({ repeat: -1 });
    tl_eye_left
        .to(".iris-left-diamond", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-left-square",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        )
        .to(".iris-left-square", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-left-triangle",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        )
        .to(".iris-left-triangle", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-left-star",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        )
        .to(".iris-left-star", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-left-diamond",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        );

    tl_eye_right
        .to(".iris-right-diamond", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-right-square",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        )
        .to(".iris-right-square", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-right-triangle",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        )
        .to(".iris-right-triangle", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-right-star",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        )
        .to(".iris-right-star", {
            duration: EYES_FRAME_DURATION,
            ease: EASE_FUNCTION,
            opacity: 0,
        })
        .to(
            ".iris-right-diamond",
            { duration: EYES_FRAME_DURATION, ease: EASE_FUNCTION, opacity: 1 },
            "<",
        );

    // Person reacts on hover
    const person = document.querySelector(".girl-with-cat");

    person?.addEventListener("mouseenter", () => {
        tl_eye_left.pause();
        tl_eye_right.pause();
        gsap.to(".iris", { opacity: 0 });
        gsap.to(".iris-left-open", { opacity: 1 });
        gsap.to(".iris-right-open", { opacity: 1 });
        gsap.to(".dialogue-bubble", { opacity: 1, visibility: "visible" });
    });

    person?.addEventListener("mouseleave", () => {
        gsap.to(".iris-left-open", { opacity: 0 });
        gsap.to(".iris-right-open", { opacity: 0 });
        tl_eye_left.resume();
        tl_eye_right.resume();
        gsap.to(".dialogue-bubble", { opacity: 0, visibility: "hidden" });
    });
</script>
