---
import spiderBody from "../assets/web-design-spider/spider-without-legs-and-web.webp";
import legLeftTop from "../assets/web-design-spider/spider-leg-left-top.webp";
import legLeftMiddleTop from "../assets/web-design-spider/spider-leg-left-middle-top.webp";
import legLeftMiddleBottom from "../assets/web-design-spider/spider-leg-left-middle-bottom.webp";
import legLeftBottom from "../assets/web-design-spider/spider-leg-left-bottom.webp";
import legRightTop from "../assets/web-design-spider/spider-leg-right-top.webp";
import legRightMiddleTop from "../assets/web-design-spider/spider-leg-right-middle-top.webp";
import legRightMiddleBottom from "../assets/web-design-spider/spider-leg-right-middle-bottom.webp";
import legRightBottom from "../assets/web-design-spider/spider-leg-right-bottom.webp";

const { class: className } = Astro.props;
---

<div class:list={["web-design-comp-container", className]}>
  <svg
    width="100%"
    viewBox="0 0 1750 1234"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    id="web-design-animated"
  >
    <title>Hand-drawn spider hanging over a web design illustration</title>
    <image
      id="spider-without-legs-and-web"
      x="0"
      y="0"
      width="1750"
      height="1234"
      preserveAspectRatio="none"
      xlink:href={spiderBody.src}></image>
    <image
      id="spider-leg-right-bottom"
      x="991"
      y="1109"
      width="191"
      height="46"
      xlink:href={legRightBottom.src}></image>
    <image
      id="spider-leg-right-middle-bottom"
      x="1054"
      y="1046"
      width="148"
      height="61"
      xlink:href={legRightMiddleBottom.src}></image>
    <image
      id="spider-leg-right-middle-top"
      x="1112"
      y="947"
      width="169"
      height="101"
      xlink:href={legRightMiddleTop.src}></image>
    <image
      id="spider-leg-right-top"
      x="1116"
      y="777"
      width="114"
      height="219"
      xlink:href={legRightTop.src}></image>
    <image
      id="spider-leg-left-bottom"
      x="747"
      y="830"
      width="117"
      height="191"
      xlink:href={legLeftBottom.src}></image>
    <image
      id="spider-leg-left-middle-bottom"
      x="786"
      y="771"
      width="105"
      height="208"
      xlink:href={legLeftMiddleBottom.src}></image>
    <image
      id="spider-leg-left-middle-top"
      x="863"
      y="743"
      width="62"
      height="217"
      xlink:href={legLeftMiddleTop.src}></image>
    <image
      id="spider-leg-left-top"
      x="899"
      y="779"
      width="74"
      height="169"
      xlink:href={legLeftTop.src}></image>
  </svg>
</div>

<script>
  import { gsap } from "gsap";

  // Animation data: [finalX, finalY, finalRotation]
  const animationData = {
    "spider-leg-left-top": { transformOrigin: "bottom left", rotation: 5 },
    "spider-leg-left-middle-top": {
      transformOrigin: "bottom right",
      rotation: 5,
    },
    "spider-leg-left-middle-bottom": {
      transformOrigin: "bottom right",
      rotation: 5,
    },
    "spider-leg-left-bottom": { transformOrigin: "bottom right", rotation: 5 },
    "spider-leg-right-top": { transformOrigin: "bottom right", rotation: 5 },
    "spider-leg-right-middle-top": {
      transformOrigin: "bottom right",
      rotation: 5,
    },
    "spider-leg-right-middle-bottom": {
      transformOrigin: "bottom right",
      rotation: 5,
    },
    "spider-leg-right-bottom": { transformOrigin: "bottom right", rotation: 5 },
  };

  const svg = document.getElementById("web-design-animated");
  let timeline: gsap.core.Timeline;

  // Set initial state
  Object.entries(animationData).forEach(([id, data]) => {
    const element = document.getElementById(id);
    if (element) {
      gsap.set(element, {
        rotation: 0, // Rotate 10 degrees
        transformOrigin: data.transformOrigin, // Pivot from the top-left (where it connects to body)
      });
    }
  });

  // Create timeline
  function createTimeline() {
    timeline = gsap.timeline({ paused: true });

    Object.entries(animationData).forEach(([id, data]) => {
      const element = document.getElementById(id);
      if (element) {
        timeline.to(
          element,
          {
            rotation: data.rotation,
            duration: 0.5,
            yoyo: true, // Go back and forth
            repeat: -1, // Loop forever
            ease: "sine.inOut",
          },
          0, // Start all animations at the same time
        );
      }
    });
  }

  // Initialize
  createTimeline();

  // Hover event handlers
  svg?.addEventListener("mouseenter", () => {
    timeline.play();
  });

  svg?.addEventListener("mouseleave", () => {
    timeline.reverse();
  });
</script>

<style>
  .web-design-comp-container {
    display: inline-block;
    cursor: pointer;
  }

  #web-design-animated {
    display: block;
  }
</style>
