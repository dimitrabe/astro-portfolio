---
const today = new Date();
import SocialLinks from '../components/SocialLinks.astro';
---

<footer>
	<p>&copy; {today.getFullYear()} Dimitra Be for bedesignlab. All rights reserved.</p>
	<SocialLinks />
</footer>
<style>
	footer {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 2em 1em 1em 1em;
		color: rgb(var(--gray));
		text-align: center;
	}	
	footer > p {
		padding: 0;
		margin: 0;
		text-align: left;
	}
</style>
