---
const today = new Date();
import SocialLinks from '../components/SocialLinks.astro';
---

<footer>
	<p class="body-small">&copy; {today.getFullYear()} Dimitra Be for bedesignlab. All rights reserved.</p>
	<SocialLinks />
</footer>
<style>
	footer {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 0 1em 1em 1em;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer > p {
		padding: 0;
		margin: 0;
		text-align: left;
	}
	@media (max-width: 768px) {
		footer {
			justify-content: center;
		}
		footer :global(.social-links) {
			display: none;
		}
	}
</style>
