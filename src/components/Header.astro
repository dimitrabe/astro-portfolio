---
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
const { pathname } = Astro.url;
const isHomepage = pathname === "/";
---

<header class:list={[{ 'homepage': isHomepage }]}>
	<nav>
		<Logo />
		{
			!isHomepage && (
				<div class="internal-links">
					<HeaderLink class="body" href="/">home</HeaderLink>
					<HeaderLink class="body" href="/paintings">paintings</HeaderLink>
					<HeaderLink class="body" href="/graphic-design">
						graphic design
					</HeaderLink>
					<a class="body" href="https://bedesignlab.com" target="_blank">
						web design
					</a>
					<HeaderLink class="body" href="/about">about</HeaderLink>
				</div>
			)
		}
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: transparent;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: static;  /* Default for all pages */
	}

	header.homepage {
		position: fixed;  /* Only on homepage */
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	/* nav a {
		padding: 0.5em 0.5em;
		display: inline-block;
