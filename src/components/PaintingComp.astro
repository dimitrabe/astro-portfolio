---
import { getCollection } from 'astro:content';

const svgWidth = 680;
const svgHeight = 720;
const canvasX = Math.round(svgWidth * 0.2);
const canvasY = Math.round(svgHeight * 0.083);
const canvasWidth = Math.round(svgWidth * 0.6);
const canvasHeight = Math.round(svgHeight * 0.8);

const allPosts = await getCollection('blog');
const [latestPainting] = allPosts
  .filter((post) => post.data.category === 'paintings')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const heroImage = latestPainting?.data.heroImage;
---

<div class="easel-container">
  <svg
    id="easel-svg"
    width="100%"
    viewBox={`0 0 ${svgWidth} ${svgHeight}`}
    data-canvas-x={canvasX}
    data-canvas-y={canvasY}
    data-canvas-width={canvasWidth}
    data-canvas-height={canvasHeight}
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <clipPath id="canvas-clip">
        <rect
          x={canvasX}
          y={canvasY}
          width={canvasWidth}
          height={canvasHeight}
          rx="2"></rect>
      </clipPath>
      <filter id="canvas-shadow" x="-50%" y="-50%" width="200%" height="200%">
        <feDropShadow dx="1" dy="1" stdDeviation="0" flood-opacity="1" flood-color="var(--dark-purple)"
        ></feDropShadow>
      </filter>
      <!-- White rect visible by default = painting hidden; brush strokes are
           punched in as black, which erases the white overlay there. -->
      <mask id="reveal-mask" maskUnits="userSpaceOnUse">
        <rect x={canvasX} y={canvasY} width={canvasWidth} height={canvasHeight} fill="#FFFFFF"></rect>
        <g id="brush-strokes"></g>
      </mask>
    </defs>

    <!-- Painting, revealed as the white overlay is brushed away -->
    {heroImage && (
      <image
        href={heroImage.src}
        x={canvasX}
        y={canvasY}
        width={canvasWidth}
        height={canvasHeight}
        preserveAspectRatio="xMidYMid slice"
        clip-path="url(#canvas-clip)"></image>
    )}

    <!-- White canvas overlay with shadow, masked away where brushed -->
    <rect
      id="canvas-area"
      x={canvasX}
      y={canvasY}
      width={canvasWidth}
      height={canvasHeight}
      fill="#FFFFFF"
      rx="2"
      filter="url(#canvas-shadow)"
      mask="url(#reveal-mask)"></rect>
  </svg>
</div>

<style>
  .easel-container {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
  }

  #canvas-area {
    cursor: crosshair;
  }
</style>

<script>
  import { gsap } from "gsap";

  interface Point {
    x: number;
    y: number;
  }

  const svg = document.getElementById("easel-svg") as SVGSVGElement | null;
  const canvasArea = document.getElementById("canvas-area") as SVGRectElement | null;
  const brushStrokes = document.getElementById("brush-strokes") as SVGGElement | null;

  if (!svg || !canvasArea || !brushStrokes) {
    console.error("Required SVG elements not found");
    throw new Error("Required SVG elements not found");
  }

  const canvasX = parseFloat(svg.dataset.canvasX || "0");
  const canvasY = parseFloat(svg.dataset.canvasY || "0");
  const canvasWidth = parseFloat(svg.dataset.canvasWidth || "0");
  const canvasHeight = parseFloat(svg.dataset.canvasHeight || "0");

  let isDrawing = false;
  let currentPath: SVGPathElement | null = null;
  let points: Point[] = [];

  function getSVGCoordinates(event: MouseEvent): Point {
    if (!svg) return { x: 0, y: 0 };
    const CTM = svg.getScreenCTM();
    if (!CTM) {
      return { x: 0, y: 0 };
    }
    return {
      x: (event.clientX - CTM.e) / CTM.a,
      y: (event.clientY - CTM.f) / CTM.d,
    };
  }

  function isInsideCanvas(x: number, y: number): boolean {
    return (
      x >= canvasX &&
      x <= canvasX + canvasWidth &&
      y >= canvasY &&
      y <= canvasY + canvasHeight
    );
  }

  function createSimplePath(points: Point[]): string {
    if (points.length < 2) return "";

    let path = `M ${points[0].x} ${points[0].y}`;

    for (let i = 1; i < points.length; i++) {
      path += ` L ${points[i].x} ${points[i].y}`;
    }

    return path;
  }

  // Mouse enter canvas - start a new brush stroke that erases the overlay
  canvasArea.addEventListener("mouseenter", (e: MouseEvent) => {
    isDrawing = true;
    points = [];

    currentPath = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "path",
    );
    currentPath.classList.add("brush-stroke");
    // Presentation attributes, not CSS: this element is created at runtime, so
    // it never gets Astro's scoped-style data attribute and a scoped CSS rule
    // targeting .brush-stroke would silently fail to match it.
    currentPath.setAttribute("fill", "none");
    currentPath.setAttribute("stroke", "#000000");
    currentPath.setAttribute("stroke-width", "32");
    currentPath.setAttribute("stroke-linecap", "round");
    currentPath.setAttribute("stroke-linejoin", "round");
    brushStrokes.appendChild(currentPath);

    gsap.fromTo(
      currentPath,
      {
        opacity: 0,
      },
      {
        opacity: 1,
        duration: 0.3,
        ease: "power2.out",
      },
    );

    const coords = getSVGCoordinates(e);
    if (isInsideCanvas(coords.x, coords.y)) {
      points.push(coords);
    }
  });

  // Mouse move - continue erasing the overlay along the cursor path
  svg.addEventListener("mousemove", (e: MouseEvent) => {
    if (!isDrawing || !currentPath) return;

    const coords = getSVGCoordinates(e);

    if (isInsideCanvas(coords.x, coords.y)) {
      points.push(coords);

      const pathData = createSimplePath(points);
      currentPath.setAttribute("d", pathData);
    }
  });

  // Mouse leave canvas - stop drawing
  canvasArea.addEventListener("mouseleave", () => {
    isDrawing = false;
    currentPath = null;
    points = [];
  });

  // Also stop on mouse leaving entire SVG
  svg.addEventListener("mouseleave", () => {
    isDrawing = false;
    currentPath = null;
    points = [];
  });
</script>
