      preserveAspectRatio="none"
      clip-path="url(#clip-letter-D)"></image>
  </svg>
</div>

<script>
  import { gsap } from "gsap";

  // Animation data: [finalX, finalY, finalRotation]
  const animationData = {
    "letter-C": { x: 485.94, y: -164.42, rotation: 0, scaleX: 1 },
    "letter-I-a": { x: 281.08, y: -163, rotation: 0, scaleX: 1 },
    "letter-H": { x: 155.08, y: -98, rotation: 0, scaleX: 1 },
    "letter-P": { x: 170.08, y: -70, rotation: 90, scaleX: 1 },
    "letter-A": { x: -11.26, y: -207, rotation: 0, scaleX: 1 },
    "letter-R": { x: 84.84, y: -58, rotation: 0, scaleX: -1 },
    "letter-G-a": { x: -69, y: 122.33, rotation: 0, scaleX: 1 },
    "letter-N-a": { x: 293.14, y: 175, rotation: 0, scaleX: 1 },
    "letter-N-b": { x: 293.15, y: 175, rotation: 0, scaleX: 1 },
    "letter-G-b": { x: 137.16, y: 117.19, rotation: 179.4, scaleX: 1 },
    "letter-I-b": { x: -0.86, y: 39, rotation: 0, scaleX: 1 },
    "letter-S": { x: -140, y: -45.1, rotation: 90, scaleX: 1 },
    "letter-E": { x: 4.15, y: -54, rotation: 0, scaleX: 1 },
    "letter-D": { x: -309, y: 39.58, rotation: 0, scaleX: 1 },
  };

  const svg = document.getElementById("graphic-design-animated");
  let timeline: gsap.core.Timeline;

  // Set initial state
  Object.entries(animationData).forEach(([id, data]) => {
    const element = document.getElementById(id);
    if (element) {
      gsap.set(element, {
        x: 0,
        y: 0,
        rotation: 0,
        scaleX: 1,
        transformOrigin: "center center",
      });
    }
  });

  // Create timeline
  function createTimeline() {
    timeline = gsap.timeline({ paused: true });

    Object.entries(animationData).forEach(([id, data]) => {
      const element = document.getElementById(id);
      if (element) {
        timeline.to(
          element,
          {
            x: data.x,
            y: data.y,
            rotation: data.rotation,
            scaleX: data.scaleX,
            duration: 2,
            ease: "power2.inOut",
          },
          0, // Start all animations at the same time
        );
      }
    });
  }

  // Initialize
  createTimeline();

  // Hover event handlers
  svg?.addEventListener("mouseenter", () => {
    timeline.play();
  });

  svg?.addEventListener("mouseleave", () => {
    timeline.reverse();
  });
</script>

<style>
  .graphic-design-comp-container {
    display: inline-block;
    cursor: pointer;
  }

  #graphic-design-animated {
    display: block;
  }
</style>
