---
import spriteSrc from '../assets/eye/sprite.png';

interface Props {
  ariaLabel?: string;
}

const { ariaLabel = 'Animated eye that follows your cursor' } = Astro.props;

// Sprite sheet: 5 columns x 3 rows, each cell 595x421px
const COLS = 5;
const ROWS = 3;
const CELL_WIDTH = 595;
const CELL_HEIGHT = 421;
---

<div
  id="eye-follower"
  role="img"
  aria-label={ariaLabel}
  data-cols={COLS}
  data-rows={ROWS}
  style={`width: 100%; height: auto; max-width: 100%; aspect-ratio: ${CELL_WIDTH} / ${CELL_HEIGHT}; background-image: url(${spriteSrc.src}); background-size: ${COLS * 100}% ${ROWS * 100}%; background-repeat: no-repeat; background-position: 0% 0%; overflow: hidden;`}
>
</div>

<script>
  const COLS = 5;
  const ROWS = 3;

  const eye = document.getElementById('eye-follower') as HTMLDivElement;

  let cursorX = window.innerWidth / 2;
  let cursorY = window.innerHeight / 2;
  let lastCol = -1;
  let lastRow = -1;

  document.addEventListener('mousemove', (e) => {
    cursorX = e.clientX;
    cursorY = e.clientY;
  });

  // Center cell of the grid — reserved exclusively for the hover state
  const CENTER_COL = Math.floor(COLS / 2);
  const CENTER_ROW = Math.floor(ROWS / 2);

  function tick() {
    const rect = eye.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;

    const isHovered =
      cursorX >= rect.left && cursorX <= rect.right && cursorY >= rect.top && cursorY <= rect.bottom;

    let col: number;
    let row: number;

    if (isHovered) {
      col = CENTER_COL;
      row = CENTER_ROW;
    } else {
      const dx = cursorX - centerX;
      const dy = cursorY - centerY;

      // Normalize against the distance from the eye's own center to the
      // nearest viewport edge in that direction — not the viewport's
      // center — so every row/column is reachable regardless of where
      // the eye sits on the page.
      const maxX = dx < 0 ? centerX : window.innerWidth - centerX;
      const maxY = dy < 0 ? centerY : window.innerHeight - centerY;

      const normX = Math.max(-1, Math.min(1, maxX === 0 ? 0 : dx / maxX));
      const normY = Math.max(-1, Math.min(1, maxY === 0 ? 0 : dy / maxY));

      col = Math.round(((normX + 1) / 2) * (COLS - 1));
      row = Math.round(((normY + 1) / 2) * (ROWS - 1));

      // The center cell is reserved for hover — nudge away from it so
      // tracking never accidentally lands on the hover frame.
      if (col === CENTER_COL && row === CENTER_ROW) {
        row = dy < 0 ? CENTER_ROW - 1 : CENTER_ROW + 1;
      }
    }

    if (col !== lastCol || row !== lastRow) {
      lastCol = col;
      lastRow = row;
      const posX = (col / (COLS - 1)) * 100;
      const posY = (row / (ROWS - 1)) * 100;
      eye.style.backgroundPosition = `${posX}% ${posY}%`;
    }

    requestAnimationFrame(tick);
  }

  requestAnimationFrame(tick);
</script>
